# Copy to .env and fill in. Keep .env out of git (see worker/.gitignore).

# Base URL of the Cloudflare Pages backend (where the functions live).
API_BASE=https://qcb.pages.dev

# Must match the WORKER_TOKEN secret set in the Cloudflare Pages project.
WORKER_TOKEN=

# Resend (https://resend.com) — API key + a verified sender address.
RESEND_API_KEY=
MAIL_FROM=Quantum Circuit Builder <verify@your-verified-domain>

# Seconds between polls when idle.
POLL_INTERVAL=15
